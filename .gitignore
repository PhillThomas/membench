# Build output. The release binary is what everyone runs; it does not belong in
# the repository.
/target
**/*.rs.bk

# Local result dumps from `membench run --json` and `membench sweep`.
*.json
!fixtures/**/*.json
*.csv

# Secrets and local overrides. Never commit a token, however convenient the test
# box is.
*.env
.env
*.token
token*
.gogs-token
.cursor/
.vscode/

# Editor and profiler noise.
*.swp
*.log
perf.data
perf.data.old
flamegraph.svg

# The C reference benchmarks build in place and write their result dumps here
# (see reference/README.md). Only the sources belong in git.
/reference/mbstream
/reference/mblatency
/reference/*.o
/reference/bin/
/reference/out*/

# Python bytecode from the comparison script, and the reference build trees.
# Neither is source, both reappear the moment anyone runs a build.
__pycache__/
*.pyc
reference/bin/
reference/out*/
